<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
  <OutputType>WinExe</OutputType>
  <TargetFramework>net10.0-windows</TargetFramework>
  <RootNamespace>Kapi_Mu_Utility</RootNamespace>
  <Nullable>enable</Nullable>
  <UseWindowsForms>true</UseWindowsForms>
  <ImplicitUsings>enable</ImplicitUsings>
  <ApplicationIcon>recursos\Icono.ico</ApplicationIcon>
  <PlatformTarget>x64</PlatformTarget>

  <!-- Publicación en un solo EXE -->
  <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  <SelfContained>true</SelfContained>
  <PublishSingleFile>true</PublishSingleFile>
  <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  <DebugType>none</DebugType>
</PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="recursos\TradeReference.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="recursos\Icono.ico" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="recursos\TradeReference.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="Obfuscar" Version="2.2.50">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Management" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>
  
  <Target Name="ObfuscateBeforeSingleFileBundle" BeforeTargets="GenerateSingleFileBundle" DependsOnTargets="PrepareForBundle" Condition="'$(PublishSingleFile)' == 'true' and '$(Configuration)' == 'Release'">

      <Exec Command="obfuscar.console &quot;$(ProjectDir)obfuscar.xml&quot;" WorkingDirectory="$(ProjectDir)" />

      <Error Condition="!Exists('$(ProjectDir)bin\obfuscar\$(AssemblyName).dll')" Text="No se encontró el DLL ofuscado en bin\obfuscar." />

      <ItemGroup>
          <FilesToBundle Remove="@(FilesToBundle)" Condition="'%(Filename)%(Extension)' == '$(AssemblyName).dll'" />

          <FilesToBundle Include="$(ProjectDir)bin\obfuscar\$(AssemblyName).dll">
              <RelativePath>$(AssemblyName).dll</RelativePath>
          </FilesToBundle>
      </ItemGroup>

      <Message Importance="high" Text="Empaquetando DLL ofuscado: $(ProjectDir)bin\obfuscar\$(AssemblyName).dll" />

  </Target>

</Project>